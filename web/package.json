{
  "name": "beatblox-web",
  "version": "1.0.0",
  "description": "Pulls the @strudel/web bundle into the Android app assets",
  "scripts": {
    "sync": "node -e \"const fs=require('fs');fs.copyFileSync('node_modules/@strudel/web/dist/index.js','../app/src/main/assets/strudel/strudel-web.js');fs.copyFileSync('node_modules/@strudel/web/LICENSE','../app/src/main/assets/strudel/LICENSE.strudel');console.log('synced @strudel/web '+require('@strudel/web/package.json').version)\""
  },
  "type": "commonjs",
  "dependencies": {
    "@strudel/web": "^1.3.0"
  },
  "private": true
}